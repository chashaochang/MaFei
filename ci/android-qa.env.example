# Android QA pipeline variables example
# Do not put real secrets into repository.

# Required
PGY_API_KEY=replace_with_pgy_api_key

# Optional build metadata
APP_NAME=MaFei
APP_VERSION_NAME=0.0.0
ANDROID_MODULE=composeApp
ANDROID_VARIANT=Debug
RELEASE_NOTES=

# Optional pgyer settings
PGY_BUILD_INSTALL_TYPE=2
PGY_INSTALL_PASSWORD=
PGY_UPLOAD_ENDPOINT=https://www.pgyer.com/apiv2/app/upload
PGY_UPLOAD_RETRY=2
